# Repository variables; lookup and publication default off.
BOL_COVER_FALLBACK_ENABLED=false
BOL_COVER_PUBLICATION_ENABLED=false
BOL_COVER_BATCH_SIZE=100
# GitHub Secrets; reuse existing Bol credentials. Never commit filled values.
BOL_API_CLIENT_ID=
BOL_API_CLIENT_SECRET=
# Separate direct Postgres login inheriting only bol_cover_worker, sslmode=require.
BOL_COVER_DATABASE_URL=
